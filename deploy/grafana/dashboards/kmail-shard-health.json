{
  "annotations": {"list": []},
  "description": "Per-shard (Stalwart StatefulSet) health. Each shard is one kmail-stalwart-<ordinal> pod + its own PVC (deploy/helm/kmail/templates/statefulset-stalwart.yaml). Pod/PVC health comes from the kube-prometheus stack (kube-state-metrics + kubelet) that the chart's ServiceMonitor targets; tenant-facing latency comes from the BFF's kmail_jmap_proxy_* metrics. Use the $namespace variable to scope to the install.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "kmail-shard-health",
  "title": "KMail — Per-Shard Health",
  "tags": ["kmail", "shard", "stalwart", "capacity"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "textbox",
        "query": "kmail",
        "current": {"text": "kmail", "value": "kmail"}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Shards ready / desired",
      "id": 1,
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(kube_statefulset_status_replicas_ready{namespace=\"$namespace\", statefulset=~\".*-stalwart\"})", "legendFormat": "ready"},
        {"refId": "B", "expr": "sum(kube_statefulset_replicas{namespace=\"$namespace\", statefulset=~\".*-stalwart\"})", "legendFormat": "desired"}
      ],
      "options": {"colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "timeseries",
      "title": "Per-shard pod readiness (1 = ready)",
      "id": 2,
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "max by (pod) (kube_pod_status_ready{namespace=\"$namespace\", pod=~\".*-stalwart-.*\", condition=\"true\"})", "legendFormat": "{{pod}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "none", "min": 0, "max": 1}}
    },
    {
      "type": "timeseries",
      "title": "Per-shard PVC utilisation (used / capacity)",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "kubelet_volume_stats_used_bytes{namespace=\"$namespace\", persistentvolumeclaim=~\"data-.*-stalwart-.*\"} / kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\", persistentvolumeclaim=~\"data-.*-stalwart-.*\"}", "legendFormat": "{{persistentvolumeclaim}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 0.7, "color": "yellow"},
              {"value": 0.85, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Per-shard container restarts (rate)",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "rate(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\".*-stalwart-.*\"}[15m])", "legendFormat": "{{pod}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "Per-shard memory working set",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\".*-stalwart-.*\", container=\"stalwart\"})", "legendFormat": "{{pod}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "type": "timeseries",
      "title": "Per-shard CPU usage (cores)",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\".*-stalwart-.*\", container=\"stalwart\"}[5m]))", "legendFormat": "{{pod}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "Tenant-facing JMAP proxy latency (P50 / P99, all shards)",
      "id": 7,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(kmail_jmap_proxy_duration_seconds_bucket[5m])))", "legendFormat": "P50"},
        {"refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(kmail_jmap_proxy_duration_seconds_bucket[5m])))", "legendFormat": "P99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ]
}
