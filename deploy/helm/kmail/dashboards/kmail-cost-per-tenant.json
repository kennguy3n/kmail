{
  "annotations": {"list": []},
  "description": "Infrastructure cost-per-tenant model. Combines measured resource usage (CPU cores, memory, PVC capacity from the kube-prometheus stack) with adjustable unit-price variables, divided by kmail_active_tenants. Unit prices are dashboard variables ($cpu_cost $/core-hr, $mem_cost $/GiB-hr, $storage_cost $/GiB-mo) — tune them to your cloud's rates. This is a planning estimate, not billing truth.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "kmail-cost-per-tenant",
  "title": "KMail — Cost per Tenant",
  "tags": ["kmail", "cost", "finops", "capacity"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "textbox",
        "query": "kmail",
        "current": {"text": "kmail", "value": "kmail"}
      },
      {
        "name": "cpu_cost",
        "label": "$/core-hour",
        "type": "textbox",
        "query": "0.04",
        "current": {"text": "0.04", "value": "0.04"}
      },
      {
        "name": "mem_cost",
        "label": "$/GiB-hour",
        "type": "textbox",
        "query": "0.005",
        "current": {"text": "0.005", "value": "0.005"}
      },
      {
        "name": "storage_cost",
        "label": "$/GiB-month",
        "type": "textbox",
        "query": "0.06",
        "current": {"text": "0.06", "value": "0.06"}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Active tenants",
      "id": 1,
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "kmail_active_tenants"}
      ],
      "options": {"colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Est. total infra cost / month",
      "id": 2,
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "( sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"kmail-.*\", container!=\"\"}[1h])) * $cpu_cost + sum(container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"kmail-.*\", container!=\"\"}) / 1073741824 * $mem_cost ) * 730 + sum(kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\", persistentvolumeclaim=~\"data-.*-stalwart-.*\"}) / 1073741824 * $storage_cost"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 0}},
      "options": {"colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Est. cost / tenant / month",
      "id": 3,
      "gridPos": {"h": 6, "w": 9, "x": 15, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "( ( sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"kmail-.*\", container!=\"\"}[1h])) * $cpu_cost + sum(container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"kmail-.*\", container!=\"\"}) / 1073741824 * $mem_cost ) * 730 + sum(kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\", persistentvolumeclaim=~\"data-.*-stalwart-.*\"}) / 1073741824 * $storage_cost ) / clamp_min(kmail_active_tenants, 1)"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 5, "color": "yellow"},
              {"value": 10, "color": "red"}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "timeseries",
      "title": "Est. compute cost / month (CPU + memory, by component)",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "( sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"kmail-.*\", container!=\"\"}[1h])) * $cpu_cost + sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"kmail-.*\", container!=\"\"}) / 1073741824 * $mem_cost ) * 730", "legendFormat": "{{pod}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "type": "timeseries",
      "title": "Est. storage cost / month (provisioned PVC capacity)",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\", persistentvolumeclaim=~\"data-.*-stalwart-.*\"}) / 1073741824 * $storage_cost", "legendFormat": "{{persistentvolumeclaim}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "type": "timeseries",
      "title": "Cost per tenant / month (trend)",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "( ( sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"kmail-.*\", container!=\"\"}[1h])) * $cpu_cost + sum(container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"kmail-.*\", container!=\"\"}) / 1073741824 * $mem_cost ) * 730 + sum(kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\", persistentvolumeclaim=~\"data-.*-stalwart-.*\"}) / 1073741824 * $storage_cost ) / clamp_min(kmail_active_tenants, 1)", "legendFormat": "$/tenant/mo"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "type": "timeseries",
      "title": "Paid seats by plan (revenue context)",
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (plan) (kmail_seats_total)", "legendFormat": "{{plan}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ]
}
