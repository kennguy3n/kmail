# ---------------------------------------------------------------------
# Example environment for docker-compose.prod.yml.
#
# Copy to `.env.prod` (which is gitignored) and replace EVERY value with
# a real secret from your secret manager. These placeholders exist only
# so `docker compose -f docker-compose.prod.yml --env-file .env.prod.example
# config` can validate the file WITHOUT real credentials.
#
# NEVER commit a populated .env.prod.
# ---------------------------------------------------------------------

# --- datastore credentials -------------------------------------------
KMAIL_POSTGRES_PASSWORD=replace-with-strong-postgres-password
KMAIL_VALKEY_PASSWORD=replace-with-strong-valkey-password
KMAIL_MEILI_MASTER_KEY=replace-with-32-byte-meili-master-key

# --- blob store (zk-object-fabric, S3-compatible) --------------------
KMAIL_ZK_FABRIC_ACCESS_KEY=replace-with-access-key
KMAIL_ZK_FABRIC_SECRET_KEY=replace-with-secret-key

# --- mail core (Stalwart) --------------------------------------------
KMAIL_STALWART_ADMIN_USER=admin
KMAIL_STALWART_ADMIN_PASS=replace-with-strong-admin-password
# Must match the CN/SAN on Stalwart's server certificate.
KMAIL_STALWART_TLS_SERVER_NAME=stalwart

# --- identity / OIDC --------------------------------------------------
KMAIL_KCHAT_OIDC_ISSUER=https://idp.example.com/realms/kmail
KMAIL_KCHAT_OIDC_AUDIENCE=kmail-api
KMAIL_PUBLIC_BASE_URL=https://mail.example.com

# --- application secrets ---------------------------------------------
# 32-byte base64 envelope-encryption key (openssl rand -base64 32).
KMAIL_SECRETS_KEY=replace-with-base64-32-byte-key
KMAIL_STRIPE_SECRET_KEY=sk_live_replace_me
KMAIL_STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- container image --------------------------------------------------
KMAIL_IMAGE=ghcr.io/kennguy3n/kmail
KMAIL_IMAGE_TAG=latest

# --- TLS material locations (host paths bind-mounted read-only) ------
KMAIL_TLS_DIR=./deploy/tls/client
KMAIL_STALWART_TLS_DIR=./deploy/tls/stalwart

# --- alerting integrations (Alertmanager) ----------------------------
PAGERDUTY_ROUTING_KEY=replace-with-pagerduty-routing-key
OPSGENIE_API_KEY=replace-with-opsgenie-api-key

# --- Grafana ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
GRAFANA_ROOT_URL=https://grafana.example.com
