{
  "name": "@kmail/sdk-native",
  "version": "0.1.0",
  "description": "Native N-API bindings for the KMail SDK, consumed by the Electron desktop client.",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "kmail-sdk-native",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
