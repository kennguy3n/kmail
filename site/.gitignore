# Astro build output / caches
dist/
.astro/

# Content synced from ../docs/public at build time (canonical source
# lives in docs/public/, mirrored here by scripts/sync-content.mjs).
src/content/help/

# Generated data (regenerated from docs/ by scripts/sync-content.mjs)
src/data/changelog.generated.json

# OpenAPI spec copied from api/openapi/ at build time (source of truth
# is api/openapi/kmail.openapi.json, generated by api/openapi/generate.mjs)
public/openapi/

node_modules/
