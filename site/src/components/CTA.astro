---
import { SITE } from "../data/site";
interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = "Own your team's email",
  subtitle = "Set up a custom domain, migrate from Gmail or Microsoft 365, and give your team private, encrypted email in minutes.",
} = Astro.props;
---

<section class="cta">
  <div class="container cta__inner">
    <h2>{title}</h2>
    <p class="lead mx-auto">{subtitle}</p>
    <div class="cta__actions">
      <a class="btn btn--primary btn--lg" href={SITE.signupUrl}>Get started</a>
      <a class="btn btn--ghost btn--lg" href="/pricing">See pricing</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 4rem 0;
  }
  .cta__inner {
    text-align: center;
    background: linear-gradient(135deg, var(--c-brand) 0%, var(--c-accent) 100%);
    color: #fff;
    border-radius: var(--radius);
    padding: 3rem 1.5rem;
  }
  .cta__inner h2 {
    color: #fff;
  }
  .cta__inner .lead {
    color: rgba(255, 255, 255, 0.9);
  }
  .cta__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .cta__inner .btn--ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
  }
  .cta__inner .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .cta__inner .btn--primary {
    background: #fff;
    color: var(--c-brand-dark);
  }
  .cta__inner .btn--primary:hover {
    background: #f1f5f9;
  }
</style>
