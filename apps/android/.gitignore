# Gradle build outputs. Every build regenerates these directories
# from the canonical inputs (Kotlin sources, build.gradle.kts,
# the .so + .kt artifacts produced by sdk/scripts/build-android-aar.sh).
.gradle/
build/
*/build/
.idea/
local.properties

# UniFFI-generated Kotlin sources and per-ABI .so files. These are
# regenerated by `sdk/scripts/build-android-aar.sh` on every CI run
# and on every local developer's checkout — committing them would
# bloat the repo and create per-commit merge conflicts on any FFI
# API change.
#
# uniffi-bindgen emits its output under `<srcRoot>/uniffi/<crate>/`
# (package `uniffi.kmail_ffi` here), NOT under our own
# `com/kmail/sdk/generated/` subtree, so the ignore lives at the
# top of the Kotlin sourceset.
kmail-sdk/src/main/kotlin/uniffi/
kmail-sdk/src/main/jniLibs/
kmail-sdk/build/host-jna/

# IntelliJ / Android Studio.
*.iml
.idea/

# macOS noise.
.DS_Store
