# Generated by `sdk/scripts/build-ios-xcframework.sh`. Every CI run
# and every developer-local `swift build` recomputes these from
# the Rust source, so committing them would create perpetual diff
# churn (the XCFramework would change on every Rust commit even
# without an iOS-visible API change).
#
# Downstream consumers MUST run the build script before
# `swift build` / `swift test`; the macOS GHA workflow does this
# as its first step.

Frameworks/
Sources/KMail/Generated/

# Swift Package Manager build artifacts.
.build/
.swiftpm/
Package.resolved

# Xcode-specific user state.
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
